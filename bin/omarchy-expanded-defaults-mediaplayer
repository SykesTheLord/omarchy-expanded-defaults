#!/bin/bash

# omarchy:summary=Set the default media player for Omarchy and XDG handlers
# omarchy:args=[mpv|vlc|celluloid|haruna]
# omarchy:examples=omarchy-expanded-defaults-mediaplayer mpv

MIMETYPES=(video/mp4 video/x-matroska video/webm video/quicktime video/mpeg video/x-msvideo audio/mpeg audio/flac audio/ogg audio/x-wav)

if (($# == 0)); then
  case "$(xdg-mime query default "${MIMETYPES[0]}" 2>/dev/null)" in
  mpv.desktop) echo "mpv" ;;
  vlc.desktop) echo "vlc" ;;
  io.github.celluloid_player.Celluloid.desktop) echo "celluloid" ;;
  org.kde.haruna.desktop) echo "haruna" ;;
  *) xdg-mime query default "${MIMETYPES[0]}" 2>/dev/null ;;
  esac
  exit 0
fi

case "$1" in
mpv) desktop_id="mpv.desktop"; name="mpv"; glyph=󰎁 ;;
vlc) desktop_id="vlc.desktop"; name="VLC"; glyph=󰎁 ;;
celluloid) desktop_id="io.github.celluloid_player.Celluloid.desktop"; name="Celluloid"; glyph=󰎁 ;;
haruna) desktop_id="org.kde.haruna.desktop"; name="Haruna"; glyph=󰎁 ;;
*)
  echo "Usage: omarchy-expanded-defaults-mediaplayer <mpv|vlc|celluloid|haruna>"
  exit 1
  ;;
esac

xdg-mime default "$desktop_id" "${MIMETYPES[@]}" || exit 1

source "$(dirname "$(readlink -f "$0")")/lib/common.sh"
omarchy_ed_notify "$glyph" "$name is now the default media player"
