#!/bin/bash

# omarchy:summary=Print a device's current priority rank for a class
# omarchy:args=<sinks|sources|cameras> <device-id>
# omarchy:examples=omarchy-expanded-defaults-priority-rank sinks alsa_output.pci-0000_00_1f.3.analog-stereo

set -euo pipefail

dir="$(dirname "$(readlink -f "$0")")"
source "$dir/lib/common.sh"

class="${1:-}"
id="${2:-}"

case "$class" in
sinks | sources | cameras) ;;
*)
  echo "Usage: omarchy-expanded-defaults-priority-rank <sinks|sources|cameras> <device-id>" >&2
  exit 1
  ;;
esac

omarchy_ed_ensure_store

jq -r --arg class "$class" --arg id "$id" '
  (.[$class] // []) as $list
  | ($list | map(.id) | index($id)) as $idx
  | if $idx == null then "" else ($idx + 1) end
' "$OMARCHY_ED_PRIORITIES"
