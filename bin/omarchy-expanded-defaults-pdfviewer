#!/bin/bash

# omarchy:summary=Set the default PDF viewer for Omarchy and XDG handlers
# omarchy:args=[evince|zathura|okular|xreader]
# omarchy:examples=omarchy-expanded-defaults-pdfviewer zathura

MIMETYPES=(application/pdf)

if (($# == 0)); then
  case "$(xdg-mime query default "${MIMETYPES[0]}" 2>/dev/null)" in
  org.gnome.Evince.desktop) echo "evince" ;;
  org.pwmt.zathura.desktop) echo "zathura" ;;
  org.kde.okular.desktop) echo "okular" ;;
  xreader.desktop) echo "xreader" ;;
  *) xdg-mime query default "${MIMETYPES[0]}" 2>/dev/null ;;
  esac
  exit 0
fi

case "$1" in
evince) desktop_id="org.gnome.Evince.desktop"; name="Evince"; glyph=󰈙 ;;
zathura) desktop_id="org.pwmt.zathura.desktop"; name="Zathura"; glyph=󰈙 ;;
okular) desktop_id="org.kde.okular.desktop"; name="Okular"; glyph=󰈙 ;;
xreader) desktop_id="xreader.desktop"; name="Xreader"; glyph=󰈙 ;;
*)
  echo "Usage: omarchy-expanded-defaults-pdfviewer <evince|zathura|okular|xreader>"
  exit 1
  ;;
esac

xdg-mime default "$desktop_id" "${MIMETYPES[@]}" || exit 1

source "$(dirname "$(readlink -f "$0")")/lib/common.sh"
omarchy_ed_notify "$glyph" "$name is now the default PDF viewer"
